PORT=8787
HOST=127.0.0.1

TOP_N=20
POLL_INTERVAL_MS=60000
HISTORY_SIZE=180
CONCURRENCY=6
REQUEST_TIMEOUT_MS=15000
ENDPOINT_CACHE_TTL_MS=300000
MIN_REQUEST_GAP_MS=120

# DISABLE_PERSIST=true stops writing ./data/*.json snapshots
DISABLE_PERSIST=false

# Optional: enables live inference probes against the top models.
# Without a key the monitor still works fully (catalog + provider telemetry).
PROBE_ENABLED=false
PROBE_TOP_N=5
PROBE_EVERY_CYCLES=10
PROBE_MAX_TOKENS=8
OPENROUTER_API_KEY=

# Duplicate file finder: read-only, on demand from the dashboard.
# Roots default to the current user home; AppData, node_modules, .git and other
# cache/artefact folders are skipped. Overrides are semicolon separated.
# DUPLICATES_ENABLED=false hides the panel and returns 503 on /api/duplicates.
# DUPLICATE_ROOTS=C:\Users\me\Documents;C:\Users\me\Downloads
DUPLICATES_ENABLED=true
DUPLICATE_MIN_SIZE_BYTES=1024
DUPLICATE_MAX_FILE_BYTES=536870912
DUPLICATE_MAX_FILES=750000
DUPLICATE_MAX_DEPTH=12
DUPLICATE_CONCURRENCY=6
DUPLICATE_TOP_GROUPS=300
