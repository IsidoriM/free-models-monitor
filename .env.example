PORT=8787
HOST=127.0.0.1

TOP_N=20
POLL_INTERVAL_MS=60000
HISTORY_SIZE=180
CONCURRENCY=6
REQUEST_TIMEOUT_MS=15000
ENDPOINT_CACHE_TTL_MS=300000
MIN_REQUEST_GAP_MS=120

# DISABLE_PERSIST=true stops writing ./data/*.json snapshots
DISABLE_PERSIST=false

# Optional: enables live inference probes against the top models.
# Without a key the monitor still works fully (catalog + provider telemetry).
PROBE_ENABLED=false
PROBE_TOP_N=5
PROBE_EVERY_CYCLES=10
PROBE_MAX_TOKENS=8
OPENROUTER_API_KEY=

# Trojan file triage: read-only heuristics over file names, folders and the first
# bytes of each file. It never deletes, quarantines or runs anything - it only
# ranks suspects. Roots default to the current user home with the same cache and
# artefact folders skipped, so add them back explicitly to hunt inside AppData.
# TROJANS_ENABLED=false hides the panel and returns 503 on /api/trojans.
# TROJAN_ROOTS=C:\Users\me\Downloads;C:\Users\me\Desktop
# TROJAN_HOT_DIRS=C:\Users\me\Downloads;C:\Users\me\Desktop;%TEMP%
TROJANS_ENABLED=true
TROJAN_MIN_SIZE_BYTES=1
TROJAN_MAX_FILE_BYTES=536870912
TROJAN_MAX_INSPECT_BYTES=67108864
TROJAN_MAX_FILES=750000
TROJAN_MAX_DEPTH=12
TROJAN_CONCURRENCY=8
TROJAN_TOP_FINDINGS=300
TROJAN_RECENT_DAYS=30
